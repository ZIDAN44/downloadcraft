<?xml version="1.0" encoding="utf-8"?>
<!--
  DownloadCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util
  extensions: `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`).
  Built by package.ps1:

    wix build downloadcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc downloadcraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-user install (no UAC prompt), by default into %LOCALAPPDATA%\Programs\DownloadCraft, so test
  builds update themselves without elevation (docs/updates.md); the same layout as craft-launcher's
  installer (storytold/craft-launcher), which the shared Windows ARM64 test checks.

  Double-clicked, it opens a setup wizard: Welcome; a folder page with a "Create a desktop
  shortcut" box; Ready; progress; Finish, with a ticked "Launch DownloadCraft" box. The folder and
  the shortcut choice are recorded under HKCU and reused by later versions, so an update (the
  updater runs this with /passive, which skips the wizard) lands in the same folder; the updater
  reads the recorded folder to know it was installed by this MSI.

  Per-user packages can't use a file as a component's KeyPath (ICE38), so each component is keyed
  on an HKCU value, and the folders made are removed on uninstall (ICE64).

  UpgradeCode is fixed for DownloadCraft forever; never change it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="DownloadCraft"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="6A1F8E52-3C7B-4D19-9E2A-5B84C0D3F716"
      Scope="perUser"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="DownloadCraft download manager" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of DownloadCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows 10 or later: the Rust standard library has needed it since 1.78, and DownloadCraft
         draws with DirectX 12. `Installed` keeps repair and uninstall working on any Windows. -->
    <Property Id="WINDOWS10ORLATER" Secure="yes">
      <RegistrySearch Id="WindowsMajorVersion" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
          Name="CurrentMajorVersionNumber" Type="raw" />
    </Property>
    <Launch Condition="Installed OR WINDOWS10ORLATER" Message="DownloadCraft needs Windows 10 or later." />

    <!-- The Apps & features icon only (MSI caches it under the product code, which every update
         changes); the shortcuts take the exe's own icon, at a path every update keeps. -->
    <Icon Id="DownloadCraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DownloadCraftIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ZIDAN44/downloadcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/ZIDAN44/downloadcraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DownloadCraft" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- An update installs where the user put the previous version (recorded by DownloadCraftApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\Learning Machines LLC\DownloadCraft" Name="InstallDir" Type="raw" />
    </Property>

    <!-- The desktop shortcut: ticked on a first install; an update keeps the last choice. A value
         given on the command line (INSTALLDESKTOPSHORTCUT=0 or 1) wins. -->
    <Property Id="PREVIOUSDESKTOPSHORTCUT">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="HKCU" Key="Software\Learning Machines LLC\DownloadCraft" Name="DesktopShortcutChoice" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLDESKTOPSHORTCUT AND ((NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT PREVIOUSDESKTOPSHORTCUT) OR PREVIOUSDESKTOPSHORTCUT = &quot;1&quot;)" />
    <SetProperty Id="DESKTOPSHORTCUTCHOICE" Action="RememberNoDesktopShortcut" Value="0" Before="InstallInitialize" Sequence="execute"
        Condition="NOT (INSTALLDESKTOPSHORTCUT = &quot;1&quot;)" />
    <SetProperty Id="DESKTOPSHORTCUTCHOICE" Action="RememberDesktopShortcut" Value="1" Before="InstallInitialize" Sequence="execute"
        Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;" />

    <Feature Id="Main" Title="DownloadCraft" Level="1">
      <ComponentGroupRef Id="DownloadCraftFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (MIT OR Apache-2.0: nothing to
         accept), with a folder page that adds the desktop-shortcut box. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="DownloadCraftInstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="DownloadCraftInstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchDownloadCraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <Dialog Id="DownloadCraftInstallDirDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="DoAction" Value="WixUIValidatePath_$(sys.BUILDARCHSHORT)" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
          <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallDirDlgDescription)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallDirDlgTitle)" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="290" Height="30" NoPrefix="yes" Text="!(loc.InstallDirDlgFolderLabel)" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="100" Width="320" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="120" Width="56" Height="17" Text="!(loc.InstallDirDlgChange)">
          <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
        </Control>
        <Control Id="PerUserNote" Type="Text" X="20" Y="146" Width="330" Height="24" NoPrefix="yes" Text="!(loc.DownloadCraftInstallDirNote)" />

        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="186" Width="330" Height="17" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="!(loc.DownloadCraftDesktopShortcut)" />
      </Dialog>
    </UI>
    <!-- Drawn by package.ps1 from DownloadCraft's icon. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric and drops a pre-release tag), shown on the wizard's
         pages through downloadcraft.en-us.wxl. -->
    <Property Id="DownloadCraftVersion" Value="$(var.DisplayVersion)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="DownloadCraft $(var.DisplayVersion) is installed. Start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch DownloadCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#DownloadCraftExe]" />
    <!-- Runs in the wizard's own process, so DownloadCraft starts as the user. -->
    <CustomAction Id="LaunchDownloadCraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="DownloadCraftFiles">
      <Component Id="DownloadCraftApp" Directory="INSTALLFOLDER" Guid="3E9B7C21-48A6-4F0D-A5C3-9D17E2B860F4">
        <File Id="DownloadCraftExe" Source="$(var.BinDir)\downloadcraft.exe" KeyPath="no" />
        <File Id="DownloadCraftCliExe" Source="$(var.BinDir)\downloadcraft-cli.exe" KeyPath="no" />
        <!-- Read back by the next version's installer and by the updater (self_update.rs). -->
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\DownloadCraft" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\DownloadCraft" Name="DesktopShortcutChoice" Value="[DESKTOPSHORTCUTCHOICE]" Type="string" />
        <!-- Win+R "downloadcraft". -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\downloadcraft.exe" Value="[#DownloadCraftExe]" Type="string" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
      </Component>

      <Component Id="DownloadCraftShortcut" Directory="ProgramMenuFolder" Guid="8C4D2A97-1B5E-4E73-9F06-C2A8B5E1D349">
        <Shortcut Id="StartMenuShortcut" Name="DownloadCraft" Description="Download files, pause them and carry on later"
            Target="[#DownloadCraftExe]" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="ai.storyteller.downloadcraft" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\DownloadCraft" Name="StartMenuShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>

      <!-- Only when the folder page's box is ticked. -->
      <Component Id="DownloadCraftDesktopShortcut" Directory="DesktopFolder" Guid="B2E64F1D-7A39-4C85-8D0E-5F93A1C7E248"
          Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="DownloadCraft" Description="Download files, pause them and carry on later"
            Target="[#DownloadCraftExe]" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="ai.storyteller.downloadcraft" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\DownloadCraft" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
